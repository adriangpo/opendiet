#!/usr/bin/env sh
# OpenDiet pre-push gate (see AGENTS.md). CI is the authoritative gate; this is the fast local mirror.
# Enable once with: git config core.hooksPath .githooks
set -e

hook_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
dart_safe="$hook_dir/../tool/dart_safe"
flutter_safe="$hook_dir/../tool/flutter_safe"

git_dir="$(git rev-parse --git-dir 2>/dev/null || :)"
current_tree="$(git rev-parse 'HEAD^{tree}' 2>/dev/null || :)"
cache_file=''
if [ -n "$git_dir" ] && [ -n "$current_tree" ]; then
  cache_file="$git_dir/opendiet/pre-push-passed-tree"
  if [ -r "$cache_file" ] && [ "$(cat "$cache_file")" = "$current_tree" ]; then
    echo "[pre-push] current tree already passed locally; skipping format/analyze/test"
    exit 0
  fi
fi

# IDEs and git GUIs invoke hooks without sourcing the user's shell profile, so
# tool dirs like the Flutter SDK are absent from PATH and dart/flutter fail to
# resolve. Recover the SDK from common locations (override with FLUTTER_ROOT).
if ! command -v flutter >/dev/null 2>&1 || ! command -v dart >/dev/null 2>&1; then
  for candidate in \
    "$FLUTTER_ROOT/bin" \
    "$HOME/flutter/bin" \
    "$HOME/fvm/default/bin" \
    "$HOME/development/flutter/bin" \
    "$HOME/.asdf/shims" \
    "/opt/flutter/bin" \
    "/usr/local/flutter/bin"; do
    if [ -x "$candidate/flutter" ]; then
      PATH="$candidate:$PATH"
      export PATH
      break
    fi
  done
fi

# Resolve FLUTTER_ROOT after PATH discovery so non-interactive hooks can read
# the SDK version from bin/cache/flutter.version.json.
if [ -z "$FLUTTER_ROOT" ]; then
  resolved_flutter="$(command -v flutter)" && [ -n "$resolved_flutter" ] && {
    FLUTTER_ROOT="$(dirname "$(dirname "$resolved_flutter")")"
    export FLUTTER_ROOT
  }
fi

for tool in dart flutter; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "[pre-push] $tool not found on PATH." >&2
    echo "[pre-push] Your launcher (likely an IDE/GUI) did not load your shell profile." >&2
    echo "[pre-push] Set FLUTTER_ROOT to your Flutter SDK, or add it to the candidate list in .githooks/pre-push." >&2
    exit 1
  fi
done

echo "[pre-push] dart format --set-exit-if-changed ."
"$dart_safe" format --output=none --set-exit-if-changed .

echo "[pre-push] flutter analyze"
"$flutter_safe" analyze

echo "[pre-push] flutter test"
"$flutter_safe" test

if [ -n "$cache_file" ]; then
  cache_dir="$(dirname "$cache_file")"
  mkdir -p "$cache_dir"
  tmp_file="$(mktemp "$cache_dir/pre-push-passed-tree.XXXXXXXX")"
  printf '%s\n' "$current_tree" > "$tmp_file"
  mv "$tmp_file" "$cache_file"
fi

echo "[pre-push] OK"
